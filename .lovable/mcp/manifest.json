{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "star-runner-mcp",
      "version": "0.1.0",
      "title": "Star·Runner MCP"
    },
    "tools": [
      {
        "name": "get_game_info",
        "title": "Get game info",
        "description": "Return an overview of the Star·Runner game: premise, controls, and scoring.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "score_rating",
        "title": "Rate a score",
        "description": "Return a pilot rank for a given Star·Runner score.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "The final score achieved in a run."
            }
          },
          "required": [
            "score"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
